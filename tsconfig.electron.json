{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "electron"],
    "strict": true,
    "outDir": "./dist-electron"
  },
  "include": ["electron/**/*"],
  "exclude": ["src/**/*", "node_modules", "dist*/**/*"]
}
